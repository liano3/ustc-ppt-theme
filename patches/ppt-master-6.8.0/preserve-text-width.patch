+def _cjk_renderer_slack(run: dict[str, Any]) -> float:
+    """Allow East Asian quote widths and renderer-added inter-script spacing.
+
+    Some Office-compatible renderers use full-em curly quotes in Chinese runs
+    and quarter-em spacing at Latin/digit boundaries, even with explicit spaces.
+    This is frame slack only: glyph positions, raw measurements and imported
+    exact frames remain unchanged. Latin-only quotations need no correction.
+    """
+    text = str(run.get('text', ''))
+    if not any(is_cjk_char(ch) for ch in text):
+        return 0.0
+    size = font_px_to_hpt(float(run.get('font_size', 16))) / FONT_PX_TO_HUNDREDTHS_PT
+    slack = sum(
+        max(0.0, size - _estimate_run_text_width(dict(run, text=ch)))
+        for ch in text if ch in '\u2018\u2019\u201c\u201d'
+    )
+    previous = None
+    for ch in text:
+        if ch.isspace():
+            continue
+        current = 'cjk' if is_cjk_char(ch) and ch.isalnum() else (
+            'latin' if ch.isascii() and ch.isalnum() else None
+        )
+        if previous is not None and current is not None and previous != current:
+            slack += size * 0.25
+        previous = current
+    return slack
 
 
