+"""Keep authored Chinese line breaks under the same slack as single lines."""
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+from xml.etree import ElementTree as ET
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from svg_to_pptx.drawingml.converter import convert_svg_to_slide_shapes
+from svg_to_pptx.drawingml.elements import _cjk_renderer_slack
+
+NS = {'a': 'http://schemas.openxmlformats.org/drawingml/2006/main',
+      'p': 'http://schemas.openxmlformats.org/presentationml/2006/main'}
+
+
+class PreservedTextWidthTests(unittest.TestCase):
+    def test_chinese_quotes_and_date_boundaries_get_targeted_slack(self):
+        run = {'font_family': 'Arial, Microsoft YaHei', 'font_size': 24}
+        self.assertGreater(_cjk_renderer_slack(dict(run, text='按“反馈”出题')), 24)
+        self.assertEqual(_cjk_renderer_slack(dict(run, text='2026 年 11 月 1 日')), 30)
+        self.assertEqual(_cjk_renderer_slack(dict(run, text='An “English” title')), 0)
+        self.assertEqual(_cjk_renderer_slack(dict(run, text='纯中文标题')), 0)
+
+    def export(self, body, mode='preserve', anchor='start', frame=''):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / 'text.svg'
+            path.write_text(
+                '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 720">'
+                f'<text x="600" y="150" font-family="Arial, Microsoft YaHei" '
+                f'font-size="26" text-anchor="{anchor}" {frame}>{body}</text></svg>'
+            )
+            xml, *_ = convert_svg_to_slide_shapes(path, resource_root=Path(tmp), text_flow=mode)
+        return ET.fromstring(xml).find('.//p:sp', NS)
+
+    def geometry(self, shape):
+        xf = shape.find('p:spPr/a:xfrm', NS)
+        return int(xf.find('a:off', NS).get('x')), int(xf.find('a:ext', NS).get('cx'))
+
+    def test_preserved_lines_have_single_line_slack_and_keep_anchor(self):
+        text = '奖励集参与教师更新，V_test 始终单独保留。'
+        for anchor in ('start', 'middle', 'end'):
+            with self.subTest(anchor=anchor):
+                single = self.export(text, anchor=anchor)
+                multi = self.export(f'<tspan x="600">{text}</tspan>'
+                                    '<tspan x="600" dy="42">较短的第二行</tspan>', anchor=anchor)
+                # The same longest line must not lose its safety margin simply
+                # because a second authored line is added.
+                self.assertEqual(self.geometry(single), self.geometry(multi))
+                self.assertEqual(multi.find('p:txBody/a:bodyPr', NS).get('wrap'), 'none')
+
+    def test_reflow_retains_narrower_wrapping_constraint(self):
+        body = '<tspan x="600">同样低成功率，下一步应该怎样编辑任务？</tspan><tspan x="600" dy="42">第二行</tspan>'
+        preserved = self.export(body)
+        reflow = self.export(body, mode='reflow')
+        self.assertGreater(self.geometry(preserved)[1], self.geometry(reflow)[1])
+        self.assertEqual(reflow.find('p:txBody/a:bodyPr', NS).get('wrap'), 'square')
+
+    def test_imported_exact_frame_is_not_expanded(self):
+        body = '<tspan x="600">任务图与训练历史</tspan><tspan x="600" dy="42">第二行</tspan>'
+        for mode in ('preserve', 'reflow'):
+            shape = self.export(body, mode=mode, frame='data-pptx-frame="580 100 400 150"')
+            self.assertEqual(self.geometry(shape), (580 * 9525, 400 * 9525))
+
+
+if __name__ == '__main__':
+    unittest.main()
